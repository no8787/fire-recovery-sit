# Supabase 프로젝트 설정값 (supabase.com 대시보드 > Project Settings > API)
# 실제 값은 .env.local에만 넣고 절대 커밋하지 마세요 (.gitignore의 .env* 규칙으로 이미 제외됨).

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon / publishable key
# (브라우저에 노출되어도 되는 키. RLS 정책이 실제 접근 범위를 통제한다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role / secret key
# 절대 브라우저로 보내지 말 것. RLS를 완전히 우회하므로 서버 코드(API route)에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오톡 채널 1:1 상담 링크 (예: https://pf.kakao.com/_xxxxxxx/chat)
# 비워두면 Hero/Footer/MobileCTA/FloatingActions의 카카오 버튼이 전화 상담으로 자동 대체된다.
NEXT_PUBLIC_KAKAO_CHAT_URL=
